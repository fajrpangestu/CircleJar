<% var sz = { sm: 'h-8 w-8 text-xs', md: 'h-11 w-11 text-base', lg: 'h-20 w-20 text-3xl' }[cls] || 'h-10 w-10 text-sm'; %>
<% if (u.avatar) { %><img src="<%= u.avatar %>" alt="<%= u.name %>" class="<%= sz %> shrink-0 rounded-full bg-slate-200 object-cover ring-2 ring-white"><% } else { %><span class="<%= sz %> inline-grid shrink-0 place-items-center rounded-full bg-gradient-to-br from-indigo-500 to-fuchsia-500 font-bold text-white ring-2 ring-white"><%= (u.name || '?').charAt(0).toUpperCase() %></span><% } %>
